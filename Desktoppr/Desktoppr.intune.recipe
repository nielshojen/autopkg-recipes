<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Downloads the latest version of Desktoppr.</string>
	<key>Identifier</key>
	<string>com.github.nielshojen.intune.Desktoppr</string>
	<key>Input</key>
	<dict>
        <key>INSTALL_AS_MANAGED</key>
        <string>False</string>
		<key>NAME</key>
		<string>Desktoppr</string>
		<key>categories</key>
		<array>
			<string>Productivity</string>
		</array>
		<key>description</key>
		<string>Simple command line tool which can read and set the desktop picture</string>
		<key>developer</key>
		<string>scriptingosx</string>
		<key>display_name</key>
		<string>Desktoppr</string>
	</dict>
	<key>MinimumVersion</key>
	<string>1.1</string>
	<key>ParentRecipe</key>
	<string>com.github.moofit-recipes.download.Desktoppr</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>app_file</key>
				<string>%pathname%</string>
				<key>bundleId</key>
				<string>com.scriptingosx.desktoppr</string>
				<key>bundleVersion</key>
				<string>%version%</string>
				<key>description</key>
				<string>%description%</string>
				<key>displayname</key>
				<string>%display_name%</string>
				<key>icon</key>
				<string></string>
				<key>publisher</key>
				<string>%developer%</string>
				<key>version</key>
				<string>%version%</string>
				<key>install_as_managed</key>
				<string>%INSTALL_AS_MANAGED%</string>
			</dict>
			<key>Processor</key>
			<string>com.github.almenscorner.intune-upload.processors/IntuneAppUploader</string>
		</dict>
	</array>
</dict>
</plist>